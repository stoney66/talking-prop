# ---------------------------------------------------------------- end to end
def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def run_fake_server(handler, port, seconds):
    websockets = pytest.importorskip("websockets")

    async def serve():
        async with websockets.serve(handler, "127.0.0.1", port):
            await asyncio.sleep(seconds)

    threading.Thread(target=lambda: asyncio.run(serve()), daemon=True).start()
    time.sleep(0.5)


def start_client(port, extra_args=()):
    args = tp.parse_args(["--url", "ws://127.0.0.1:%d/v1/realtime" % port, "--no-servo", "--no-search",
                          "--mic-rate", "48000", "--out-rate", "48000", *extra_args])
    jaw = tp.Jaw(tp.load_chatterpi_config("/nonexistent.ini"), enabled=False)
    moves = []
    jaw.move = moves.append
    app = tp.TalkingProp(args, jaw)
    for fn in (app.run_socket, app.send_mic, app.watch_speaking):
        threading.Thread(target=fn, daemon=True).start()
    return app, moves


def test_conversation_plays_reply_moves_jaw_and_mutes_mic():
    port = free_port()
    reply = (np.sin(np.arange(16000) * 0.2) * 9000).astype(np.int16).tobytes()  # 1 s
    got = {"session": None, "appends": 0, "loud_while_talking": 0}

    async def handler(ws):
        sent = False
        async for raw in ws:
            event = json.loads(raw)
            if event["type"] == "session.update":
                got["session"] = event["session"]
            elif event["type"] == "input_audio_buffer.append":
                got["appends"] += 1
                pcm = np.frombuffer(base64.b64decode(event["audio"]), dtype=np.int16)
                if got.get("talking") and pcm.any():
                    got["loud_while_talking"] += 1
                if got["appends"] == 5 and not sent:
                    sent = True
                    for i in range(0, len(reply), 3200):
                        await ws.send(json.dumps({"type": "response.output_audio.delta",
                                                  "delta": base64.b64encode(reply[i:i + 3200]).decode()}))
                    got["talking"] = True

    run_fake_server(handler, port, 4)
    app, moves = start_client(port, ["--voice", "pirate"])
    played = 0
    mic = (np.ones(1920, dtype=np.int16) * 500).tobytes()  # 40 ms at 48 kHz, never silent
    end = time.time() + 2
    while time.time() < end:
        app.on_mic(mic, 1920, None, None)
        for _ in range(2):
            out, _ = app.on_speaker(None, 960, None, None)
            assert len(out) == 960 * 2
            played += int(np.frombuffer(out, dtype=np.int16).any())
        time.sleep(0.04)
        if played >= 45:
            got["talking"] = False
    session = got["session"]
    assert session["audio"]["output"]["voice"] == "pirate"
    assert session["audio"]["input"]["format"] == {"type": "audio/pcm", "rate": None}
    assert [tool["name"] for tool in session["tools"]] == ["get_current_time"]
    assert got["appends"] > 20
    assert played >= 45  # about one second of 20 ms playback callbacks
    assert any(angle != 90 for angle in moves)


def test_search_tool_round_trip(tmp_path, monkeypatch):
    key_file = tmp_path / "brave_key.txt"
    key_file.write_text("KEY")
    real = tp.brave_search
    monkeypatch.setattr(tp, "brave_search", lambda key, q: real(key, q, opener=fake_brave))
    port = free_port()
    log = []

    async def handler(ws):
        asked = False
        async for raw in ws:
            event = json.loads(raw)
            kind = event["type"]
            if kind == "session.update":
                log.append(("tools", [t["name"] for t in event["session"]["tools"]]))
            elif kind == "input_audio_buffer.append" and not asked:
                asked = True
                await ws.send(json.dumps({"type": "response.created"}))
                await ws.send(json.dumps({"type": "response.function_call_arguments.done", "name": "web_search",
                                          "arguments": json.dumps({"query": "oxnard weather"}),
                                          "call_id": "c1"}))
                await asyncio.sleep(0.3)  # the result must wait for response.done
                log.append(("done", time.monotonic()))
                await ws.send(json.dumps({"type": "response.done"}))
            elif kind == "conversation.item.create":
                log.append(("output", time.monotonic(), event["item"]))
            elif kind == "response.create":
                log.append(("response.create",))

    run_fake_server(handler, port, 3)
    args = tp.parse_args(["--url", "ws://127.0.0.1:%d/v1/realtime" % port, "--no-servo",
                          "--brave-key-file", str(key_file)])
    app = tp.TalkingProp(args, tp.Jaw(tp.load_chatterpi_config("/nonexistent.ini"), enabled=False))
    for fn in (app.run_socket, app.send_mic):
        threading.Thread(target=fn, daemon=True).start()
    end = time.time() + 2
    while time.time() < end:
        app.on_mic((np.ones(640, dtype=np.int16) * 300).tobytes(), 640, None, None)
        time.sleep(0.04)
    assert ("tools", ["get_current_time", "web_search"]) in log
    output = next(e for e in log if e[0] == "output")
    done = next(e for e in log if e[0] == "done")
    assert output[1] >= done[1]
    assert output[2]["call_id"] == "c1"
    assert json.loads(output[2]["output"])["results"][0]["source"] == "weather.example.com"
    assert ("response.create",) in log


def test_current_time_tool():
    now = tp.current_time()
    assert set(now) == {"date", "time", "timezone"}
    assert not now["time"].startswith("0")


def test_kid_safe_session_rule():
    args = tp.parse_args(["--url", "ws://x", "--no-servo", "--no-search", "--kid-safe"])
    app = tp.TalkingProp(args, tp.Jaw(tp.load_chatterpi_config("/nonexistent.ini"), enabled=False))
    instructions = app.session_update()["session"]["instructions"]
    assert instructions.startswith(tp.KID_SAFE_RULE)
    assert tp.current_time()["date"] in instructions


def test_clock_refresh_resends_session_while_idle():
    port = free_port()
    updates = []

    async def handler(ws):
        async for raw in ws:
            if json.loads(raw)["type"] == "session.update":
                updates.append(time.monotonic())

    run_fake_server(handler, port, 4)
    args = tp.parse_args(["--url", "ws://127.0.0.1:%d/v1/realtime" % port, "--no-servo", "--no-search",
                          "--clock-refresh", "1"])
    app = tp.TalkingProp(args, tp.Jaw(tp.load_chatterpi_config("/nonexistent.ini"), enabled=False))
    for fn in (app.run_socket, app.refresh_clock):
        threading.Thread(target=fn, daemon=True).start()
    time.sleep(3.5)
    assert len(updates) >= 3  # the initial one plus refreshes
    app.stop.set()


