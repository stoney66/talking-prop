def chunk(value, n=320):
    return np.full(n, value, dtype=np.int16)


# ---------------------------------------------------------------- jaw
def test_jaw_levels_with_default_config():
    jaw = tp.Jaw(tp.load_chatterpi_config("/nonexistent.ini"), enabled=False)
    assert (jaw.closed, jaw.open) == (90, 0)
    assert [jaw.target(chunk(v)) for v in (0, 1600, 2600, 4000)] == [90, 60.0, 30.0, 0]
    assert jaw.target(chunk(-32768)) == 0  # no int16 overflow in abs()
    assert jaw.target(np.array([], dtype=np.int16)) == 90


def test_jaw_reversed_angles(tmp_path):
    ini = tmp_path / "config.ini"
    ini.write_text("[SERVO]\nmin_angle = 270\nmax_angle = 0\n")
    jaw = tp.Jaw(tp.load_chatterpi_config(str(ini)), enabled=False)
    assert (jaw.closed, jaw.open) == (270, 0)
    assert jaw.target(chunk(2600)) == 90.0


def test_single_threshold_style(tmp_path):
    ini = tmp_path / "config.ini"
    ini.write_text("[CONTROLLER]\nstyle = 0\nthreshold = 2000\n")
    jaw = tp.Jaw(tp.load_chatterpi_config(str(ini)), enabled=False)
    assert jaw.target(chunk(1999)) == jaw.closed
    assert jaw.target(chunk(2001)) == jaw.open


def test_resampling():
    assert len(tp.downsample(np.arange(960, dtype=np.int16), 3)) == 320
    assert len(tp.upsample(chunk(1), 3)) == 960
    with pytest.raises(SystemExit):
        tp.rate_factor(44100)


# ---------------------------------------------------------------- devices
class FakePyAudio:
    devices = [
        {"index": 0, "name": "bcm2835 Headphones", "maxInputChannels": 0, "maxOutputChannels": 8},
        {"index": 1, "name": "USB Audio Device", "maxInputChannels": 1, "maxOutputChannels": 2},
        {"index": 2, "name": "sysdefault", "maxInputChannels": 128, "maxOutputChannels": 128},
        {"index": 3, "name": "default", "maxInputChannels": 128, "maxOutputChannels": 128},
    ]

    def get_device_count(self):
        return len(self.devices)

    def get_device_info_by_index(self, i):
        return self.devices[i]


def test_find_device():
    pa = FakePyAudio()
    assert tp.find_device(pa, None, True) is None
    assert tp.find_device(pa, "default", True) == 3  # exact name beats "sysdefault"
    assert tp.find_device(pa, "usb", False) == 1
    for bad in ("0", "9", "nope"):
        with pytest.raises(SystemExit):
            tp.find_device(pa, bad, True)


# ---------------------------------------------------------------- brave
class FakeResponse(io.BytesIO):
    def __enter__(self):
        return self

    def __exit__(self, *exc):
        return False


def fake_brave(request, timeout):
    assert request.get_header("X-subscription-token") == "KEY"
    assert "safesearch=strict" in request.full_url
    return FakeResponse(json.dumps({"web": {"results": [{
        "title": "Oxnard <strong>Weather</strong>",
        "url": "https://weather.example.com/oxnard",
        "description": "Sunny, high of 72&deg;F &amp; light wind",
    }]}}).encode())


def test_brave_search_parsing():
    result = tp.brave_search("KEY", "oxnard weather", opener=fake_brave)
    assert result["results"][0] == {
        "title": "Oxnard Weather",
        "snippet": "Sunny, high of 72°F & light wind",
        "source": "weather.example.com",
    }


def test_brave_search_failure():
    def broken(request, timeout):
        raise OSError("network down")

    assert "error" in tp.brave_search("KEY", "x", opener=broken)


